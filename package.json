{
  "name": "owasp-oasis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":    "wrangler dev --var ENVIRONMENT:development",
    "build": "npm run check",
    "deploy": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env=\"\"",
    "test": "node --test",
    "check": "node --check worker.js && node --check hubspot.js && node --test"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
