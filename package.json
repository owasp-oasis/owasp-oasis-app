{
  "name": "owasp-oasis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "build:worker": "tsc -p tsconfig.worker.json",
    "build:frontend": "vite build",
    "build": "tsc -b && npm run build:worker && npm run build:frontend",
    "preview": "vite preview",
    "deploy:preview": "npm run build && wrangler deploy",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "diff": "^9.0.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "wrangler": "^4.78.0"
  }
}
