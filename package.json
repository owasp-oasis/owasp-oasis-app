{
  "name": "owasp-oasis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "build:worker": "tsc -p tsconfig.worker.json",
    "build:frontend": "vite build",
    "build": "tsc -b && npm run build:worker && npm run build:frontend",
    "preview": "vite preview",
    "check": "npm test && npm run build",
    "migrate:preview": "wrangler d1 migrations apply oasis-db --remote --env=\"\"",
    "migrate:production": "wrangler d1 migrations apply oasis-db --remote --env production",
    "deploy:preview": "npm run migrate:preview && wrangler deploy --env=\"\"",
    "deploy": "npm run migrate:production && wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/worker/unit",
    "test:int": "vitest run tests/worker/integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "diff": "^9.0.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.78.0"
  }
}
